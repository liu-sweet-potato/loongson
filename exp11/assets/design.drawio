        <mxCell id="uK6yIKYAZt-z7Kzolbb--10" value="&lt;div style=&quot;text-wrap: nowrap;&quot;&gt;流水线握手信号理解：&lt;/div&gt;&lt;div style=&quot;text-wrap: nowrap;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;allowin: 互锁（向后）&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap: nowrap;&quot;&gt;validout: 握手（向前）&lt;/div&gt;&lt;div style=&quot;text-wrap: nowrap;&quot;&gt;ready_go: 阻塞（本级）&lt;/div&gt;&lt;div style=&quot;text-wrap: nowrap;&quot;&gt;valid(cancel): 置空（本级）&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="uK6yIKYAZt-z7Kzolbb--9" vertex="1">
