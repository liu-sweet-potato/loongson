        <mxCell id="uK6yIKYAZt-z7Kzolbb--5" value="Item 1:&lt;span style=&quot;text-wrap: nowrap;&quot;&gt;Imm_Ext, br_unit, instr_dec&lt;/span&gt;&lt;span style=&quot;text-wrap: nowrap; background-color: initial;&quot;&gt;统一为一个模块便于复用&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="uK6yIKYAZt-z7Kzolbb--4" vertex="1">
